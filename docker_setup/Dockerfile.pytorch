FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    USE_CUDA=0 \
    USE_ROCM=0 \
    BUILD_TEST=0 \
    BUILD_IGNORE_SVE_UNAVAILABLE=1 \
    MAX_JOBS=4 \
    CFLAGS="--coverage -O0" \
    CXXFLAGS="--coverage -O0" \
    LDFLAGS="--coverage"

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates curl wget build-essential ninja-build cmake pkg-config \
    python3 python3-pip python3-dev python3-venv python-is-python3 \
    gcovr lcov \
    libopenblas-dev libssl-dev zlib1g-dev && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install coverage pandas openpyxl requests numpy pyyaml typing_extensions sympy

WORKDIR /workspace

ARG PYTORCH_REF=v2.7.1

RUN git clone --recursive --branch ${PYTORCH_REF} https://github.com/pytorch/pytorch.git && \
    cd /workspace/pytorch && \
    python -m pip install -r requirements.txt || true && \
    python -m pip install --no-build-isolation -e .

RUN python3 -c "import torch; print(torch.__version__); print(torch.__file__)"

CMD ["bash"]