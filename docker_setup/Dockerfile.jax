FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

RUN apt-get update && apt-get install -y --no-install-recommends \
    git ca-certificates curl wget unzip zip build-essential pkg-config clang \
    python3 python3-pip python3-dev python3-venv python-is-python3 \
    openjdk-17-jdk \
    gcovr lcov && rm -rf /var/lib/apt/lists/*

RUN python -m pip install --upgrade pip setuptools wheel && \
    python -m pip install coverage pandas openpyxl requests numpy bazelisk

WORKDIR /workspace
CMD ["bash"]
